#include "moergo_includes.h"
#include "moergo_macros.h"

////////////////////////////////////////////////////////////////
// https://zmk.dev/docs/keymaps#multiple-layers

#define __KEYMAP_LAYERS

#define LAYER_BASE        0
#define LAYER_VARIOUS     (LAYER_BASE + 1)
#define LAYER_SYS         (LAYER_VARIOUS + 1)
#define LAYER_NUM         (LAYER_SYS + 1)
#define LAYER_NUMNAV      (LAYER_NUM + 1)
#define LAYER_SYM         (LAYER_NUMNAV + 1)
#define LAYER_FUN         (LAYER_SYM + 1)
#define LAYER_MODFUN      (LAYER_FUN + 1)
#define LAYER_MACROS      (LAYER_MODFUN + 1)
#define LAYER_NAV         (LAYER_MACROS + 1)
#define _LAYER_TEMPLATE   (LAYER_NAV + 1)

////////////////////////////////////////////////////////////////

#define __KEYS

#define XXX             &none
#define ___             &trans
#define NOOP            0

#define KEY_UNDO        LC(Z)
#define KEY_REDO        LC(Y)

#define KEY_CUT         LC(X)
#define KEY_COPY        LC(C)
#define KEY_PASTE       LC(V)

#if MOERGO_OS == MOERGO_OS_WINDOWS_OR_LINUX
#define KEY_MOD_APP_TOGGLE  LALT
#define KEY_APP_TOGGLE      LA(TAB)
#define KEY_APP_QUIT        LA(F4)
#elif MOERGO_OS == MOERGO_OS_MACOS
#define KEY_MOD_APP_TOGGLE  LGUI
#define KEY_APP_TOGGLE      LG(TAB)
#define KEY_APP_QUIT        LG(Q)
#endif

#define KEY_MEH         LA(LC(LSHIFT))
#define KEY_HYPER       LG(KEY_MEH)
#define KEY_META_CTRL   LG(LCTRL)


////////////////////////////////////////////////////////////////
// https://zmk.dev/docs/keymaps/behaviors

#define __BEHAVIORS

// https://zmk.dev/docs/keymaps/behaviors/caps-word
&caps_word {
    /delete-property/ ignore-modifiers; // mods deactivate caps-word, requires PR #1451
};

// https://github.com/urob/zmk-auto-layer/tree/zero-param?tab=readme-ov-file#example-numword
&num_word {
    continue-list = <
        BSPC DEL
        MINUS PLUS
        COMMA
        DOT
    >;
};

// // https://zmk.dev/docs/keymaps/behaviors/sticky-key
// &sk {
//     release-after-ms = <900>;  // release after 0.6s
//     quick-release;             // no double capitalization when rolling keys
// };

// // https://zmk.dev/docs/keymaps/behaviors/sticky-layer
// &sl {
//     ignore-modifiers;          // allow chording sticky mods & layers
// };

// // https://zmk.dev/docs/keymaps/behaviors/layers#layer-tap
// &lt {
//     flavor = "balanced";
//     tapping-term-ms = <200>;
//     quick-tap-ms = <175>;
// };

// // https://zmk.dev/docs/keymaps/behaviors/mod-tap#mod-tap
// &mt {
//     flavor = "tap-preferred";
//     tapping-term-ms = <220>;
//     quick-tap-ms = <220>;
//     hold-trigger-key-positions = <0>;
// };

////////////////////////////////////////////////////////////////
// https://zmk.dev/docs/keymaps/behaviors/hold-tap

#define ____BEHAVIOURS__HOLD_TAP__HRM

#define ZMK_HOLD_TAP_HRM(name, binding_hold, binding_tap, hold_trigger_key_positions) \
    ZMK_HOLD_TAP(name, \
        bindings = <binding_hold>, <binding_tap>; \
        flavor = "balanced"; \
        tapping-term-ms = <MOERGO_HOLD_TAP__TAPPING_TERM_MS>; \
        quick-tap-ms = <MOERGO_HOLD_TAP__QUICK_TAP_MS>; \
        require-prior-idle-ms = <MOERGO_HOLD_TAP__REQUIRE_PRIOR_IDLE_MS>; \
        hold-trigger-key-positions = <hold_trigger_key_positions>; \
        hold-trigger-on-release; \
    )

////////////////

ZMK_HOLD_TAP_HRM(ht_lhrm_kp_kp, &kp, &kp, KEYS_R THUMBS)
ZMK_HOLD_TAP_HRM(ht_rhrm_kp_kp, &kp, &kp, KEYS_L THUMBS)

ZMK_HOLD_TAP_HRM(ht_lhrm_mo_kp, &mo, &kp, KEYS_R THUMBS)
ZMK_HOLD_TAP_HRM(ht_rhrm_mo_kp, &mo, &kp, KEYS_L THUMBS)

////////////////

#define LHRM_KP_KP(key_on_hold, key_on_tap) ht_lhrm_kp_kp key_on_hold key_on_tap
#define RHRM_KP_KP(key_on_hold, key_on_tap) ht_rhrm_kp_kp key_on_hold key_on_tap

////////////////

#define LHRM_MO_KP(layer_on_hold, key_on_tab) ht_lhrm_mo_kp layer_on_hold key_on_tab
#define RHRM_MO_KP(layer_on_hold, key_on_tab) ht_rhrm_mo_kp layer_on_hold key_on_tab

////////////////

#define ZMK_HOLD_TAP_LHRM_KP_MM(mm_on_tap) \
    ZMK_HOLD_TAP_HRM(ht_lhrm_kp_mm_ ## mm_on_tap, &kp, &mm_on_tap, KEYS_R THUMBS)
#define LHRM_KP_MM(key_on_hold, mm_on_tap) \
    ht_lhrm_kp_mm_ ## mm_on_tap key_on_hold NOOP

#define ZMK_HOLD_TAP_RHRM_KP_MM(mm_on_tap) \
    ZMK_HOLD_TAP_HRM(ht_rhrm_kp_mm_ ## mm_on_tap, &kp, &mm_on_tap, KEYS_L THUMBS)
#define RHRM_KP_MM(key_on_hold, mm_on_tap) \
    ht_rhrm_kp_mm_ ## mm_on_tap key_on_hold NOOP

////////////////

#define ZMK_HOLD_TAP_LHRM_MO_MM(mm_on_tap) \
    ZMK_HOLD_TAP_HRM(ht_lhrm_mo_mm_ ## mm_on_tap, &mo, &mm_on_tap, KEYS_R THUMBS)
#define LHRM_MO_MM(layer_on_hold, mm_on_tap) \
    ht_lhrm_mo_mm_ ## mm_on_tap layer_on_hold NOOP

#define ZMK_HOLD_TAP_RHRM_MO_MM(mm_on_tap) \
    ZMK_HOLD_TAP_HRM(ht_rhrm_mo_mm_ ## mm_on_tap, &mo, &mm_on_tap, KEYS_L THUMBS)
#define RHRM_MO_MM(layer_on_hold, mm_on_tap) \
    ht_rhrm_mo_mm_ ## mm_on_tap layer_on_hold NOOP

////////////////

#define ZMK_HOLD_TAP_LHRM_MACRO_KP(macro_on_hold) \
    ZMK_HOLD_TAP_HRM(ht_lhrm_macro_kp_ ## macro_on_hold, &macro_on_hold, &kp, KEYS_R THUMBS)
#define LHRM_MACRO_KP(macro_on_hold, key_on_tap) \
    ht_lhrm_macro_kp_ ## macro_on_hold NOOP key_on_tap

#define ZMK_HOLD_TAP_RHRM_MACRO_KP(macro_on_hold) \
    ZMK_HOLD_TAP_HRM(ht_rhrm_macro_kp_ ## macro_on_hold, &macro_on_hold, &kp, KEYS_L THUMBS)
#define RHRM_MACRO_KP(macro_on_hold, key_on_tap) \
    ht_rhrm_macro_kp_ ## macro_on_hold NOOP key_on_tap

////////////////

#define ZMK_HOLD_TAP_LHRM_MACRO_MM(macro_on_hold, mm_on_tap) \
    ZMK_HOLD_TAP_HRM(ht_lhrm_macro_mm_ ## macro_on_hold ## _ ## mm_on_tap, &macro_on_hold, &mm_on_tap, KEYS_R THUMBS)
#define LHRM_MACRO_MM(macro_on_hold, mm_on_tap, layer_on_hold) \
    ht_lhrm_macro_mm_ ## macro_on_hold ## _ ## mm_on_tap layer_on_hold NOOP

#define ZMK_HOLD_TAP_RHRM_MACRO_MM(macro_on_hold, mm_on_tap) \
    ZMK_HOLD_TAP_HRM(ht_rhrm_macro_mm_ ## macro_on_hold ## _ ## mm_on_tap, &macro_on_hold, &mm_on_tap, KEYS_L THUMBS)
#define RHRM_MACRO_MM(macro_on_hold, mm_on_tap, layer_on_hold) \
    ht_rhrm_macro_mm_ ## macro_on_hold ## _ ## mm_on_tap layer_on_hold NOOP

////////////////

// Generic pattern: hold = layer + fixed modifier, tap = key.
#define ZMK_MACRO_ONE_PARAM_MO_KP(name, mod_on_hold) \
    ZMK_MACRO_ONE_PARAM(name, \
        wait-ms = <0>; \
        tap-ms = <0>; \
        bindings \
            = <&macro_param_1to1> \
            , <&macro_press &mo MACRO_PLACEHOLDER &kp mod_on_hold> \
            , <&macro_pause_for_release> \
            , <&macro_release &kp mod_on_hold> \
            , <&macro_param_1to1> \
            , <&macro_release &mo MACRO_PLACEHOLDER> \
            ; \
    )

#define LHRM_MO_MOD_KP(layer_on_hold, mod_on_hold, key_on_tap) \
    hlmk_ ## mod_on_hold layer_on_hold key_on_tap
#define RHRM_MO_MOD_KP(layer_on_hold, mod_on_hold, key_on_tap) \
    hrmk_ ## mod_on_hold layer_on_hold key_on_tap

#define LHRM_MO_MOD_MM(layer_on_hold, mod_on_hold, mm_on_tap) \
    hlmm_ ## mod_on_hold ## _ ## mm_on_tap layer_on_hold NOOP
#define RHRM_MO_MOD_MM(layer_on_hold, mod_on_hold, mm_on_tap) \
    hrmm_ ## mod_on_hold ## _ ## mm_on_tap layer_on_hold NOOP

////////////////////////////////

// HINT: generate manually
#define ZMK_HOLD_TAP_xHRM_MO_MOD_KP(mod_on_hold) \
    ZMK_MACRO_ONE_PARAM_MO_KP(mmk_ ## mod_on_hold, mod_on_hold) \
    ZMK_HOLD_TAP_HRM(hlmk_ ## mod_on_hold, &mmk_ ## mod_on_hold, &kp, KEYS_R THUMBS) \
    ZMK_HOLD_TAP_HRM(hrmk_ ## mod_on_hold, &mmk_ ## mod_on_hold, &kp, KEYS_L THUMBS)

ZMK_HOLD_TAP_xHRM_MO_MOD_KP(KEY_MEH)

// HINT: generate manually
#define ZMK_HOLD_TAP_xHRM_MO_MOD_MM(mod_on_hold, mm_on_tap) \
    ZMK_HOLD_TAP_HRM(hlmm_ ## mod_on_hold ## _ ## mm_on_tap, &mmk_ ## mod_on_hold, &mm_on_tap, KEYS_R THUMBS) \
    ZMK_HOLD_TAP_HRM(hrmm_ ## mod_on_hold ## _ ## mm_on_tap, &mmk_ ## mod_on_hold, &mm_on_tap, KEYS_L THUMBS)

// HINT: generated automatically (see below)
#define ZMK_HOLD_TAP_xHRM_xx_MM(mm_on_tap) \
    ZMK_HOLD_TAP_LHRM_KP_MM(mm_on_tap) \
    ZMK_HOLD_TAP_RHRM_KP_MM(mm_on_tap) \
    ZMK_HOLD_TAP_LHRM_MO_MM(mm_on_tap) \
    ZMK_HOLD_TAP_RHRM_MO_MM(mm_on_tap)


////////////////////////////////////////////////////////////////
// https://zmk.dev/docs/keymaps/behaviors/macros

#define ____BEHAVIOURS__MACRO

////////////////////////////////

ZMK_MACRO(macro_reset_keyboard_and_switch_to_base_layer,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp K_CANCEL>, <&to LAYER_BASE>; // reset keyboard and switch to base layer
)

ZMK_HOLD_TAP(ht__reset_keyboard_and_go_to_base_layer__kp,
    flavor = "balanced";
    tapping-term-ms = <MOERGO_HOLD_TAP__TAPPING_TERM_MS>;
    quick-tap-ms = <MOERGO_HOLD_TAP__QUICK_TAP_MS>;
    bindings = <&macro_reset_keyboard_and_switch_to_base_layer>, <&kp>;
)

////////////////

ZMK_MACRO(macro_browser_new_search_tab,
    bindings
        = <&kp LC(T)> // new tab
        , <&kp LC(K)> // focus address bar
        , <&kp KEY_PASTE> // paste
        ;
)

////////////////

ZMK_MACRO(macro_copy_and_toggle_app_and_paste,
    bindings
        = <&kp LC(L)> // focus address bar of source app
        , <&kp KEY_COPY> // copy
        , <&kp KEY_APP_TOGGLE> // toggle to target app (that has file dialog open)
        , <&kp HOME>  // (optional) go to beginning of line
        , <&kp KEY_PASTE> // paste
        ;
)

////////////////

ZMK_MACRO(macro_std_cpp,
    bindings
        = <&kp S &kp T &kp D &kp COLON &kp COLON> // std::
        ;
)


////////////////////////////////////////////////////////////////
// https://zmk.dev/docs/keymaps/behaviors/mod-morph

#define ____BEHAVIOURS__MOD_MORPH

////////////////////////////////

// tap: backspace | lshft + tap: delete | rshft + tap: rshift + delete
ZMK_MOD_MORPH(mm_bspc_del,
    bindings = <&kp BSPC>, <&kp DEL>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
    keep-mods = <MOD_RSFT>;
)
ZMK_HOLD_TAP_xHRM_xx_MM(mm_bspc_del)

////////////////////////////////

#define ZMK_MOD_MORPH_SIMPLE(name, mod, binding1, binding2) \
    ZMK_MOD_MORPH(name, \
        mods = <(MOD_L ## mod | MOD_R ## mod)>; \
        bindings = <binding1>, <binding2>; \
    ) \
    ZMK_HOLD_TAP_xHRM_xx_MM(name)


ZMK_MOD_MORPH_SIMPLE(mm_add_sub, SFT, &kp PLUS, &kp MINUS)
ZMK_MOD_MORPH_SIMPLE(mm_and_or, SFT, &kp AMPERSAND, &kp PIPE)
ZMK_MOD_MORPH_SIMPLE(mm_brackets, SFT, &kp LEFT_BRACKET, &kp RIGHT_BRACKET)
ZMK_MOD_MORPH_SIMPLE(mm_braces, SFT, &kp LEFT_BRACE, &kp RIGHT_BRACE)
ZMK_MOD_MORPH_SIMPLE(mm_caret_underscore, SFT, &kp CARET, &kp UNDERSCORE)
ZMK_MOD_MORPH_SIMPLE(mm_comma_semicolon, SFT, &kp COMMA, &kp SEMICOLON)
ZMK_MOD_MORPH_SIMPLE(mm_comma_singlequote, SFT, &kp COMMA, &kp SINGLE_QUOTE)
ZMK_MOD_MORPH_SIMPLE(mm_doublequotes_singlequote, SFT, &kp DOUBLE_QUOTES, &kp SINGLE_QUOTE)
ZMK_MOD_MORPH_SIMPLE(mm_dot_colon, SFT, &kp DOT, &kp COLON)
ZMK_MOD_MORPH_SIMPLE(mm_dot_doublequotes, SFT, &kp DOT, &kp DOUBLE_QUOTES)
ZMK_MOD_MORPH_SIMPLE(mm_enter_escape, SFT, &kp ENTER, &kp ESCAPE)
ZMK_MOD_MORPH_SIMPLE(mm_equal_equal, SFT, &kp EQUAL, &kp EQUAL)
ZMK_MOD_MORPH_SIMPLE(mm_excl_qmark, SFT, &kp EXCLAMATION, &kp QMARK)
ZMK_MOD_MORPH_SIMPLE(mm_grave_caret, SFT, &kp GRAVE, &kp CARET)
ZMK_MOD_MORPH_SIMPLE(mm_lt_gt, SFT, &kp LESS_THAN, &kp GREATER_THAN)
ZMK_MOD_MORPH_SIMPLE(mm_minus_plus, SFT, &kp MINUS, &kp PLUS)
ZMK_MOD_MORPH_SIMPLE(mm_mul_div, SFT, &kp ASTERISK, &kp SLASH)
ZMK_MOD_MORPH_SIMPLE(mm_parenthesis, SFT, &kp LEFT_PARENTHESIS, &kp RIGHT_PARENTHESIS)
ZMK_MOD_MORPH_SIMPLE(mm_pointer_reference, SFT, &kp ASTERISK, &kp AMPERSAND)
ZMK_MOD_MORPH_SIMPLE(mm_semicolon_semicolon, SFT, &kp SEMICOLON, &kp SEMICOLON)
ZMK_MOD_MORPH_SIMPLE(mm_slash_backslash, SFT, &kp SLASH, &kp BACKSLASH)
ZMK_MOD_MORPH_SIMPLE(mm_underscore_equal, SFT, &kp UNDERSCORE, &kp EQUAL)
ZMK_MOD_MORPH_SIMPLE(mm_underscore_minus, SFT, &kp UNDERSCORE, &kp MINUS)

ZMK_MOD_MORPH_SIMPLE(mm_keypad_add_sub, SFT, &kp KP_PLUS, &kp KP_MINUS)
ZMK_MOD_MORPH_SIMPLE(mm_keypad_dot_comma, SFT, &kp KP_DOT, &kp KP_COMMA)
ZMK_MOD_MORPH_SIMPLE(mm_keypad_mul_div, SFT, &kp KP_ASTERISK, &kp KP_SLASH)
ZMK_MOD_MORPH_SIMPLE(mm_keypad_parenthesis, SFT, &kp KP_LEFT_PARENTHESIS, &kp KP_RIGHT_PARENTHESIS)


