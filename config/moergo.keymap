// https://zmk.dev/docs/config/combos

#define ____BEHAVIOURS__COMBO

////////////////

#define COMBO_TERM_FAST 18
#define COMBO_TERM_SLOW 30

#define COMBO_IDLE_FAST 150
#define COMBO_IDLE_SLOW 50

////////////////

// ZMK_COMBO(combo_lm4_rm4, &to LAYER_SYS, LM4 RM4, ALL, COMBO_TERM_FAST, COMBO_IDLE_FAST)  // switch to system layer


////////////////////////////////////////////////////////////////

#define ____BEHAVIOURS__TRI_STATE

/*
https://github.com/dhruvinsh/zmk-tri-state:
- Pressing tri-state will fire the first behavior, and output A, as well as the second behavior, outputting B.
- Subsequent presses of tri-state will output B.
- When another key is pressed or a layer change occurs, the third, 'interrupt' behavior C will fire.

In this definition:
- A is pressing and holding KEY_MOD_APP_TOGGLE (by toggling it ON),
- B is pressing Tab, and
- C is releasing KEY_MOD_APP_TOGGLE (by toggling it OFF).
*/
#define ZMK_TRI_STATE__APP_SWITCH(name, ...)          \
    ZMK_TRI_STATE(                                    \
        name,                                         \
        bindings = <&kt KEY_MOD_APP_TOGGLE>, <&kp TAB>, <&kt KEY_MOD_APP_TOGGLE>; \
        __VA_ARGS__ \
    )

ZMK_TRI_STATE__APP_SWITCH(
    tri__app_switch__base_layer,
#if MOERGO_DEVICE == MOERGO_DEVICE_GLOVE80
    ignored-key-positions =
    <
        LF5 LF4 LF3 LF1 LH1 LH0
    >;
#endif
)

ZMK_TRI_STATE__APP_SWITCH(
    tri__app_switch__nav_layer,
    ignored-key-positions =
    <
        RT1 RT2 RT3
        RM1 RM2 RM3
        RB1     RB3
    >;
)

////////////////////////////////////////////////////////////////

#define __KEYMAP

#define ____KEYMAP_LAYER_BASE

MOERGO_LAYER(layer_base,
// ╭─────┬─────┬─────┬─────┬─────╮           ╭─────┬─────┬─────┬─────┬─────╮
// │ LC5 │ LC4 │ LC3 │ LC2 │ LC1 │           │ RC1 │ RC2 │ RC3 │ RC4 │ RC5 │
#define KEYS_LAYER_BASE_LC \
    &kp KEY_APP_QUIT \
    &kp LC(F4) \
    &kp LC(LS(TAB)) \
    &tri__app_switch__base_layer \
    &kp LC(TAB)
    KEYS_LAYER_BASE_LC
    ,
    XXX
    &macro_std_cpp
    XXX
    XXX
    XXX
    ,
// ├─────┼─────┼─────┼─────┼─────┼─────┬─────┼─────┼─────┼─────┼─────┼─────┤
// │ LN5 │ LN4 │ LN3 │ LN2 │ LN1 │ LN0 │ RN0 │ RN1 │ RN2 │ RN3 │ RN4 │ RN5 │
    &kp ESCAPE

    &kp DEL
    &kp LC(PAGE_UP)
    &kp KEY_APP_TOGGLE
    &kp LC(PAGE_DOWN)
    &kp KEY_UNDO
    ,
    &kp KEY_REDO
    &kp LA(LEFT_ARROW)
    &kp LC(SPACE)
    &kp LA(RIGHT_ARROW)
    &kp BSPC

    &kp ENTER
    ,
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │ LT5 │ LT4 │ LT3 │ LT2 │ LT1 │ LT0 │ RT0 │ RT1 │ RT2 │ RT3 │ RT4 │ RT5 │
    &kp TAB

    &kp Q
    &LHRM_KP_KP(LEFT_META, W)
    &LHRM_MO_KP(LAYER_NUM, E)
    &LHRM_MO_KP(LAYER_SYM, R)
    &kp F
    ,
    &kp Y
    &RHRM_MO_KP(LAYER_SYM, U)
    &RHRM_MO_KP(LAYER_NUMNAV, I)
    &RHRM_KP_KP(LEFT_META, O)
    &kp SINGLE_QUOTE

    &kp LS(TAB)
    ,
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │ LM5 │ LM4 │ LM3 │ LM2 │ LM1 │ LM0 │ RM0 │ RM1 │ RM2 │ RM3 │ RM4 │ RM5 │
    &kp ENTER

    &LHRM_KP_KP(LALT, A)
    &LHRM_KP_KP(LCTL, S)
    &LHRM_MO_KP(LAYER_SYM, D)
    &LHRM_KP_KP(LSFT, T)
    &LHRM_KP_KP(KEY_MEH, G)
    ,
    &RHRM_KP_KP(KEY_MEH, K)
    &RHRM_KP_KP(LSFT, N)
    &RHRM_MO_KP(LAYER_SYM, H)
    &RHRM_KP_KP(LCTL, L)
    &RHRM_KP_KP(LALT, P)

    &ht__reset_keyboard_and_go_to_base_layer__kp NOOP ESCAPE
    ,
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │ LB5 │ LB4 │ LB3 │ LB2 │ LB1 │ LB0 │ RB0 │ RB1 │ RB2 │ RB3 │ RB4 │ RB5 │
    &caps_word

    &LHRM_KP_KP(RIGHT_ALT, Z)
    &LHRM_KP_KP(KEY_META_CTRL, X)
    &kp C
    &kp V
    &LHRM_KP_KP(KEY_HYPER, B)
    ,
    &RHRM_KP_KP(KEY_HYPER, J)
    &kp M
    &mm_comma_semicolon
    &RHRM_KP_MM(KEY_META_CTRL, mm_dot_colon)
    &RHRM_KP_MM(RIGHT_ALT, mm_excl_qmark)

    &caps_word
    ,
// ├─────┼─────┼─────┼─────┼─────┼─────┴─────┼─────┼─────┼─────┼─────┼─────┤
// │ LF5 │ LF4 │ LF3 │ LF2 │ LF1 │           │ RF1 │ RF2 │ RF3 │ RF4 │ RF5 │
    &kp HOME
    &kp PAGE_UP
    ,
    &kp LEFT_ARROW
    &kp DELETE
    &kp RIGHT_ARROW
    ,
    XXX
    XXX
    XXX
    ,
    XXX
    XXX
    ,
// ├─────┼─────┼─────┼─────┴─────╯           ╰─────┴─────┼─────┼─────┼─────┤
// │ LH5 │ LH4 │ LH3 │                                   │ RH3 │ RH4 │ RH5 │
    &LHRM_MO_MM(LAYER_NAV, mm_bspc_del)
    &RHRM_KP_MM(LEFT_CONTROL, mm_minus_plus) // RHRM since modifier is used in "mouse mode" with keys on left-hand side
    ,
    &kp PRINTSCREEN
    ,
    XXX
    ,
    &RHRM_MO_MM(LAYER_MACROS, mm_underscore_equal)
    &RHRM_MO_KP(LAYER_FUN, SPACE)
    ,
// ├─────┼─────┼─────┤                                   ├─────┼─────┼─────┤
// │ LH2 │ LH1 │ LH0 │                                   │ RH0 │ RH1 │ RH2 │
    &LHRM_MO_MM(LAYER_VARIOUS, mm_slash_backslash)
    ,
    &kp PAGE_DOWN
    &kp END
    ,
    XXX
    XXX
    ,
    &RHRM_MO_MOD_KP(LAYER_MODFUN, KEY_MEH, TAB)
// ╰─────┴─────┴─────╯                                   ╰─────┴─────┴─────╯
)

////////////////////////////////////////////////////////////////

#define ____KEYMAP_LAYER_VARIOUS

MOERGO_LAYER(layer_various,
// ╭─────┬─────┬─────┬─────┬─────╮           ╭─────┬─────┬─────┬─────┬─────╮
// │ LC5 │ LC4 │ LC3 │ LC2 │ LC1 │           │ RC1 │ RC2 │ RC3 │ RC4 │ RC5 │
     ___   ___   ___   ___   ___       ,       ___   ___   ___   ___   ___,
