////////////////////////////////////////////////////////////////
// https://zmk.dev/docs/keymaps/behaviors/hold-tap

#define ____BEHAVIOURS__HOLD_TAP__HRM

/*

## HRM variants

Hold input \ Tap input | Key (&kp)          | Mod-morph (&mm)
-----------------------|--------------------|------------------------------
Key (&kp)              | [L,R]HRM_KP_KP     | [L,R]HRM_KP_MM
Layer (&mo)            | [L,R]HRM_MO_KP     | [L,R]HRM_MO_MM
Macro                  | [L,R]HRM_MACRO_KP  | [L,R]HRM_MACRO_MM
Layer + modifier       | [L,R]HRM_MO_MOD_KP | [L,R]HRM_MO_MOD_MM

## Example

ZMK_HOLD_TAP_HRM
  → creates 'lhrm_kp_kp' *behavior*
    → LHRM_KP_KP supplies its hold and tap parameters at a keymap position

'lhrm_kp_kp' is a named *ZMK behavior*, defined by:
    ZMK_HOLD_TAP_HRM(lhrm_kp_kp, &kp, &kp, KEYS_LHRM)
A keymap binding is its use at a physical key position, with arguments, for example:
    &LHRM_KP_KP(LEFT_META, W)

So this *keymap binding*:
    &LHRM_KP_KP(LEFT_META, W)
preprocesses to:
    &lhrm_kp_kp LEFT_META W

The other LHRM_* / RHRM_* macros follow the same pattern:
generic factory → concrete behavior instance → short keymap-facing alias.

## Naming patterns

Everything follows a coherent convention:

[L,R]HRM_<hold behavior>_<tap behavior>
ZMK_HOLD_TAP_xHRM_<hold behavior>_<tap behavior>
[l,r]hrm_<hold behavior>_<tap behavior>[_specific tap behavior]

## Glossary

- `ZMK`: the keyboard firmware framework that provides the behavior system.
- `[L,R]`: compact notation meaning both the left and right HRM variants.
- `[l,r]`: compact notation meaning both the left (`l`) and right (`r`) behavior variants.
- `HRM`: home-row-mod hold-tap behavior with positional triggering.
- `KP`: key-press behavior (`&kp`).
- `MO`: momentary-layer behavior (`&mo`).
- `MM`: mod-morph behavior.
- `MACRO`: macro behavior used as the hold binding.
- `MOD`: fixed modifier held together with a layer.
- `xHRM`: generator that creates both left- and right-hand HRM variants.
- `[l,r]hrm_*`: named left/right ZMK hold-tap behavior instances used by the keymap aliases.
- `KEYS_LHRM` / `KEYS_RHRM`: opposite-hand and thumb positions that trigger the corresponding HRM hold.
- `macro_mo_kp_*`: named parameterized macro behavior that holds a layer plus a fixed modifier.
- `ZMK_HOLD_TAP_HRM`: factory macro that creates one HRM behavior with shared timing and positional-trigger settings.
- `NOOP`: zero-valued placeholder for an unused behavior parameter.

Behavior names are limited to 47 visible characters by Zephyr, so generated behavior names may use abbreviations.

*/

// Creates the named HRM behavior with the shared timing and positional-trigger policy.
#define ZMK_HOLD_TAP_HRM(name, hold_binding, tap_binding, hold_trigger_key_positions) \
    ZMK_HOLD_TAP(name, \
        bindings = <hold_binding>, <tap_binding>; \
        flavor = "balanced"; \
        tapping-term-ms = <MOERGO_HOLD_TAP__TAPPING_TERM_MS>; \
        quick-tap-ms = <MOERGO_HOLD_TAP__QUICK_TAP_MS>; \
        require-prior-idle-ms = <MOERGO_HOLD_TAP__REQUIRE_PRIOR_IDLE_MS>; \
        hold-trigger-key-positions = <hold_trigger_key_positions>; \
        hold-trigger-on-release; \
    )

#define KEYS_LHRM   KEYS_LEFT_AND_RIGHT_THUMB KEYS_RIGHT_HAND
#define KEYS_RHRM   KEYS_LEFT_AND_RIGHT_THUMB KEYS_LEFT_HAND

////////////////

// Creates [l,r]hrm_<name> behaviors with the supplied hold and tap bindings.
#define ZMK_HOLD_TAP_xHRM(name, hold_binding, tap_binding) \
    ZMK_HOLD_TAP_HRM(lhrm_ ## name, hold_binding, tap_binding, KEYS_LHRM) \
    ZMK_HOLD_TAP_HRM(rhrm_ ## name, hold_binding, tap_binding, KEYS_RHRM)

ZMK_HOLD_TAP_xHRM(kp_kp, &kp, &kp)

// Provides [l,r]hrm_kp_kp behaviors that hold one keycode and tap another.
#define LHRM_KP_KP(key_on_hold, key_on_tap) lhrm_kp_kp key_on_hold key_on_tap
#define RHRM_KP_KP(key_on_hold, key_on_tap) rhrm_kp_kp key_on_hold key_on_tap

ZMK_HOLD_TAP_xHRM(mo_kp, &mo, &kp)

// Provides [l,r]hrm_mo_kp behaviors that hold a layer and tap a keycode.
#define LHRM_MO_KP(layer_on_hold, key_on_tap) lhrm_mo_kp layer_on_hold key_on_tap
#define RHRM_MO_KP(layer_on_hold, key_on_tap) rhrm_mo_kp layer_on_hold key_on_tap

////////////////

// Creates [l,r]hrm_kp_mm_<mod-morph> behaviors that hold a keycode and tap a mod-morph.
#define ZMK_HOLD_TAP_xHRM_KP_MM(mm_on_tap) \
    ZMK_HOLD_TAP_HRM(lhrm_kp_mm_ ## mm_on_tap, &kp, &mm_on_tap, KEYS_LHRM) \
    ZMK_HOLD_TAP_HRM(rhrm_kp_mm_ ## mm_on_tap, &kp, &mm_on_tap, KEYS_RHRM)

// Creates [l,r]hrm_mo_mm_<mod-morph> behaviors that hold a layer and tap a mod-morph.
#define ZMK_HOLD_TAP_xHRM_MO_MM(mm_on_tap) \
    ZMK_HOLD_TAP_HRM(lhrm_mo_mm_ ## mm_on_tap, &mo, &mm_on_tap, KEYS_LHRM) \
    ZMK_HOLD_TAP_HRM(rhrm_mo_mm_ ## mm_on_tap, &mo, &mm_on_tap, KEYS_RHRM)

// Creates both keycode-hold and layer-hold HRM behavior pairs for one mod-morph tap behavior.
#define ZMK_HOLD_TAP_xHRM_KP_AND_MO_MM(mm_on_tap) \
    ZMK_HOLD_TAP_xHRM_KP_MM(mm_on_tap) \
    ZMK_HOLD_TAP_xHRM_MO_MM(mm_on_tap)

// Provides [l,r]hrm_kp_mm_<mod-morph> behaviors that hold a keycode and tap a mod-morph.
#define LHRM_KP_MM(key_on_hold, mm_on_tap) lhrm_kp_mm_ ## mm_on_tap key_on_hold NOOP
#define RHRM_KP_MM(key_on_hold, mm_on_tap) rhrm_kp_mm_ ## mm_on_tap key_on_hold NOOP

// Provides [l,r]hrm_mo_mm_<mod-morph> behaviors that hold a layer and tap a mod-morph.
#define LHRM_MO_MM(layer_on_hold, mm_on_tap) lhrm_mo_mm_ ## mm_on_tap layer_on_hold NOOP
#define RHRM_MO_MM(layer_on_hold, mm_on_tap) rhrm_mo_mm_ ## mm_on_tap layer_on_hold NOOP

////////////////

// Creates [l,r]hrm_macro_kp_<macro> behaviors that hold a macro and tap a keycode.
#define ZMK_HOLD_TAP_xHRM_MACRO_KP(macro_on_hold) \
    ZMK_HOLD_TAP_HRM(lhrm_macro_kp_ ## macro_on_hold, &macro_on_hold, &kp, KEYS_LHRM) \
    ZMK_HOLD_TAP_HRM(rhrm_macro_kp_ ## macro_on_hold, &macro_on_hold, &kp, KEYS_RHRM)

// Creates [l,r]hrm_macro_mm_<macro>_<mod-morph> behaviors that hold a macro and tap a mod-morph.
#define ZMK_HOLD_TAP_xHRM_MACRO_MM(macro_on_hold, mm_on_tap) \
    ZMK_HOLD_TAP_HRM(lhrm_macro_mm_ ## macro_on_hold ## _ ## mm_on_tap, &macro_on_hold, &mm_on_tap, KEYS_LHRM) \
    ZMK_HOLD_TAP_HRM(rhrm_macro_mm_ ## macro_on_hold ## _ ## mm_on_tap, &macro_on_hold, &mm_on_tap, KEYS_RHRM)

// Provides [l,r]hrm_macro_kp_<macro> behaviors that hold a macro and tap a keycode.
#define LHRM_MACRO_KP(macro_on_hold, key_on_tap) lhrm_macro_kp_ ## macro_on_hold NOOP key_on_tap
#define RHRM_MACRO_KP(macro_on_hold, key_on_tap) rhrm_macro_kp_ ## macro_on_hold NOOP key_on_tap

// Provides [l,r]hrm_macro_mm_<macro>_<mod-morph> behaviors that hold a macro and tap a mod-morph.
#define LHRM_MACRO_MM(macro_on_hold, mm_on_tap, macro_param) lhrm_macro_mm_ ## macro_on_hold ## _ ## mm_on_tap macro_param NOOP
#define RHRM_MACRO_MM(macro_on_hold, mm_on_tap, macro_param) rhrm_macro_mm_ ## macro_on_hold ## _ ## mm_on_tap macro_param NOOP

////////////////

#define ZMK_MACRO_ONE_PARAM_MO_KP(name, mod_on_hold) \
    ZMK_MACRO_ONE_PARAM(name, \
        wait-ms = <0>; \
        tap-ms = <0>; \
        bindings \
            = <&macro_param_1to1> \
            , <&macro_press &mo MACRO_PLACEHOLDER &kp mod_on_hold> \
            , <&macro_pause_for_release> \
            , <&macro_release &kp mod_on_hold> \
            , <&macro_param_1to1> \
            , <&macro_release &mo MACRO_PLACEHOLDER> \
            ; \
    )

// Creates macro_mo_kp_<modifier> plus [l,r]hrm_mo_mod_kp_<modifier> behaviors.
#define ZMK_HOLD_TAP_xHRM_MO_MOD_KP(mod_on_hold) \
    ZMK_MACRO_ONE_PARAM_MO_KP(macro_mo_kp_ ## mod_on_hold, mod_on_hold) \
    ZMK_HOLD_TAP_HRM(lhrm_mo_mod_kp_ ## mod_on_hold, &macro_mo_kp_ ## mod_on_hold, &kp, KEYS_LHRM) \
    ZMK_HOLD_TAP_HRM(rhrm_mo_mod_kp_ ## mod_on_hold, &macro_mo_kp_ ## mod_on_hold, &kp, KEYS_RHRM)

// Provides macro_mo_kp_<modifier>
ZMK_HOLD_TAP_xHRM_MO_MOD_KP(KEY_MEH)

// Provides [l,r]hrm_mo_mod_kp_<modifier> behaviors that hold a layer plus modifier and tap a keycode.
#define LHRM_MO_MOD_KP(layer_on_hold, mod_on_hold, key_on_tap) lhrm_mo_mod_kp_ ## mod_on_hold layer_on_hold key_on_tap
#define RHRM_MO_MOD_KP(layer_on_hold, mod_on_hold, key_on_tap) rhrm_mo_mod_kp_ ## mod_on_hold layer_on_hold key_on_tap

// Creates [l,r]hrm_mo_mod_mm_<modifier>_<mod-morph> behaviors that hold a layer plus modifier and tap a mod-morph.
#define ZMK_HOLD_TAP_xHRM_MO_MOD_MM(mod_on_hold, mm_on_tap) \
    ZMK_HOLD_TAP_HRM(lhrm_mo_mod_mm_ ## mod_on_hold ## _ ## mm_on_tap, &macro_mo_kp_ ## mod_on_hold, &mm_on_tap, KEYS_LHRM) \
    ZMK_HOLD_TAP_HRM(rhrm_mo_mod_mm_ ## mod_on_hold ## _ ## mm_on_tap, &macro_mo_kp_ ## mod_on_hold, &mm_on_tap, KEYS_RHRM)

// Provides [l,r]hrm_mo_mod_mm_<modifier>_<mod-morph> behaviors that hold a layer plus modifier and tap a mod-morph.
#define LHRM_MO_MOD_MM(layer_on_hold, mod_on_hold, mm_on_tap) lhrm_mo_mod_mm_ ## mod_on_hold ## _ ## mm_on_tap layer_on_hold NOOP
#define RHRM_MO_MOD_MM(layer_on_hold, mod_on_hold, mm_on_tap) rhrm_mo_mod_mm_ ## mod_on_hold ## _ ## mm_on_tap layer_on_hold NOOP

////////////////////////////////////////////////////////////////
// https://zmk.dev/docs/keymaps/behaviors/macros

#define ____BEHAVIOURS__MACRO

////////////////////////////////

ZMK_MACRO(macro_reset_keyboard_and_switch_to_base_layer,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp K_CANCEL>, <&to LAYER_BASE>; // reset keyboard and switch to base layer
)

ZMK_HOLD_TAP(ht__reset_keyboard_and_go_to_base_layer__kp,
    flavor = "balanced";
    tapping-term-ms = <MOERGO_HOLD_TAP__TAPPING_TERM_MS>;
    quick-tap-ms = <MOERGO_HOLD_TAP__QUICK_TAP_MS>;
    bindings = <&macro_reset_keyboard_and_switch_to_base_layer>, <&kp>;
)

////////////////

ZMK_MACRO(macro_browser_new_search_tab,
    bindings
        = <&kp LC(T)> // new tab
        , <&kp LC(K)> // focus address bar
        , <&kp KEY_PASTE> // paste
        ;
)

////////////////

ZMK_MACRO(macro_copy_and_toggle_app_and_paste,
    bindings
        = <&kp LC(L)> // focus address bar of source app
        , <&kp KEY_COPY> // copy
        , <&kp KEY_APP_TOGGLE> // toggle to target app (that has file dialog open)
        , <&kp HOME>  // (optional) go to beginning of line
        , <&kp KEY_PASTE> // paste
        ;
)

////////////////

ZMK_MACRO(macro_std_cpp,
    bindings
        = <&kp S &kp T &kp D &kp COLON &kp COLON> // std::
        ;
)


////////////////////////////////////////////////////////////////
// https://zmk.dev/docs/keymaps/behaviors/mod-morph

#define ____BEHAVIOURS__MOD_MORPH

////////////////////////////////

// tap: backspace | lshft + tap: delete | rshft + tap: rshift + delete
ZMK_MOD_MORPH(mm_bspc_del,
    bindings = <&kp BSPC>, <&kp DEL>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
    keep-mods = <MOD_RSFT>;
)
ZMK_HOLD_TAP_xHRM_KP_AND_MO_MM(mm_bspc_del)

////////////////////////////////

// Defines a shift-sensitive mod-morph and its compatible HRM variants.
#define ZMK_MOD_MORPH_SIMPLE(name, mod, binding1, binding2) \
    ZMK_MOD_MORPH(name, \
        mods = <(MOD_L ## mod | MOD_R ## mod)>; \
        bindings = <binding1>, <binding2>; \
    ) \
    ZMK_HOLD_TAP_xHRM_KP_AND_MO_MM(name)


ZMK_MOD_MORPH_SIMPLE(mm_add_sub, SFT, &kp PLUS, &kp MINUS)
ZMK_MOD_MORPH_SIMPLE(mm_and_or, SFT, &kp AMPERSAND, &kp PIPE)
ZMK_MOD_MORPH_SIMPLE(mm_brackets, SFT, &kp LEFT_BRACKET, &kp RIGHT_BRACKET)
ZMK_MOD_MORPH_SIMPLE(mm_braces, SFT, &kp LEFT_BRACE, &kp RIGHT_BRACE)
ZMK_MOD_MORPH_SIMPLE(mm_caret_underscore, SFT, &kp CARET, &kp UNDERSCORE)
ZMK_MOD_MORPH_SIMPLE(mm_comma_semicolon, SFT, &kp COMMA, &kp SEMICOLON)
ZMK_MOD_MORPH_SIMPLE(mm_comma_singlequote, SFT, &kp COMMA, &kp SINGLE_QUOTE)
ZMK_MOD_MORPH_SIMPLE(mm_doublequotes_singlequote, SFT, &kp DOUBLE_QUOTES, &kp SINGLE_QUOTE)
ZMK_MOD_MORPH_SIMPLE(mm_dot_colon, SFT, &kp DOT, &kp COLON)
ZMK_MOD_MORPH_SIMPLE(mm_dot_doublequotes, SFT, &kp DOT, &kp DOUBLE_QUOTES)
ZMK_MOD_MORPH_SIMPLE(mm_enter_escape, SFT, &kp ENTER, &kp ESCAPE)
ZMK_MOD_MORPH_SIMPLE(mm_equal_equal, SFT, &kp EQUAL, &kp EQUAL)
ZMK_MOD_MORPH_SIMPLE(mm_excl_qmark, SFT, &kp EXCLAMATION, &kp QMARK)
ZMK_MOD_MORPH_SIMPLE(mm_grave_caret, SFT, &kp GRAVE, &kp CARET)
ZMK_MOD_MORPH_SIMPLE(mm_lt_gt, SFT, &kp LESS_THAN, &kp GREATER_THAN)
ZMK_MOD_MORPH_SIMPLE(mm_minus_plus, SFT, &kp MINUS, &kp PLUS)
ZMK_MOD_MORPH_SIMPLE(mm_mul_div, SFT, &kp ASTERISK, &kp SLASH)
ZMK_MOD_MORPH_SIMPLE(mm_parenthesis, SFT, &kp LEFT_PARENTHESIS, &kp RIGHT_PARENTHESIS)
ZMK_MOD_MORPH_SIMPLE(mm_pointer_reference, SFT, &kp ASTERISK, &kp AMPERSAND)
ZMK_MOD_MORPH_SIMPLE(mm_semicolon_semicolon, SFT, &kp SEMICOLON, &kp SEMICOLON)
ZMK_MOD_MORPH_SIMPLE(mm_slash_backslash, SFT, &kp SLASH, &kp BACKSLASH)
ZMK_MOD_MORPH_SIMPLE(mm_underscore_equal, SFT, &kp UNDERSCORE, &kp EQUAL)
ZMK_MOD_MORPH_SIMPLE(mm_underscore_minus, SFT, &kp UNDERSCORE, &kp MINUS)

ZMK_MOD_MORPH_SIMPLE(mm_keypad_add_sub, SFT, &kp KP_PLUS, &kp KP_MINUS)
ZMK_MOD_MORPH_SIMPLE(mm_keypad_dot_comma, SFT, &kp KP_DOT, &kp KP_COMMA)
ZMK_MOD_MORPH_SIMPLE(mm_keypad_mul_div, SFT, &kp KP_ASTERISK, &kp KP_SLASH)
ZMK_MOD_MORPH_SIMPLE(mm_keypad_parenthesis, SFT, &kp KP_LEFT_PARENTHESIS, &kp KP_RIGHT_PARENTHESIS)


