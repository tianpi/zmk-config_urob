#include "moergo_includes.h"
#include "zmk-helpers/key-labels/glove80.h"

#define MOERGO_DEVICE MOERGO_DEVICE_GLOVE80

////////////////////////////////////////////////////////////////

#define KEYS_FINGERS_LEFT  \
    LC5 LC4 LC3 LC2 LC1 \
    LN0 LN1 LN2 LN3 LN4 LN5 \
    LT0 LT1 LT2 LT3 LT4 LT5 \
    LM0 LM1 LM2 LM3 LM4 LM5 \
    LB0 LB1 LB2 LB3 LB4 LB5 \
    LF5 LF4 LF3 LF2 LF1


#define KEYS_FINGERS_RIGHT \
    RC1 RC2 RC3 RC4 RC5 \
    RN5 RN4 RN3 RN2 RN1 RN0 \
    RT0 RT1 RT2 RT3 RT4 RT5 \
    RM0 RM1 RM2 RM3 RM4 RM5 \
    RB0 RB1 RB2 RB3 RB4 RB5 \
    RF1 RF2 RF3 RF4 RF5

#define KEYS_THUMB_LEFT \
    LH5 LH4 LH3 LH2 LH1 LH0

#define KEYS_THUMB_RIGHT \
    RH0 RH1 RH2 RH3 RH4 RH5

#define KEYS_THUMB_LEFT_AND_RIGHT \
    KEYS_THUMB_LEFT KEYS_THUMB_RIGHT

////////////////////////////////////////////////////////////////
