#define __GLOBALS

////////////////////////////////

// https://zmk.dev/docs/keymaps/behaviors/caps-word
&caps_word {  // mods deactivate caps-word, requires PR #1451
    /delete-property/ ignore-modifiers;
};

// https://github.com/urob/zmk-auto-layer/tree/zero-param?tab=readme-ov-file#example-numword
&num_word {
    continue-list = <
        BSPC DEL
        MINUS
        COMMA
        DOT
    >;
};

