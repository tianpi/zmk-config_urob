*/


////////////////////////////////////////////////////////////////

#define MOERGO_LAYER( \
            name, \
            cl, cr, \
            nl, nr, \
            tl, tr, \
            ml, mr, \
            bl, br, \
            flb, fla, fra, frb, \
            th0la, th0lb, th0rb, th0ra, \
            th1la, th1lb, th1rb, th1ra \
        ) \
        GLV80_LAYER( \
            name, \
            cl cr nl nr tl tr ml mr bl, \
            br flb fla, \
            fra frb, \
            th0la th0lb th0rb th0ra, \
            th1la th1lb th1rb th1ra \
        )

////////////////////////////////////////////////////////////////

#include "moergo.keymap"

